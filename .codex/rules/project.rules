# Native fixed TypeScript entrypoints. Strategy HITL remains mandatory.
prefix_rule(
    pattern = ["node", "tools/verify.ts"],
    decision = "allow",
    justification = "Fixed typecheck, lint, harness and wiki tests with recorded logs.",
    match = ["node tools/verify.ts", "node tools/verify.ts --suite harness"],
    not_match = ["node tools/other.ts", "node -e 'process.exit()'"],
)
prefix_rule(
    pattern = ["node", "tools/embctl.ts", ["init", "inventory", "inspect", "render", "build", "serve", "bench", "capture", "report", "stop"]],
    decision = "allow",
    justification = "Approved lifecycle guarded by receipts, immutable inputs and resource ownership.",
    match = ["node tools/embctl.ts inspect --model /path/to/model", "node tools/embctl.ts build --strategy output/model/strategies/approved.yaml"],
    not_match = ["node tools/embctl.ts approve --model example", "node -e 'process.exit()'"],
)
prefix_rule(
    pattern = ["node", "tools/embctl.ts", "upstream", ["prepare", "check"]],
    decision = "allow",
    justification = "Official latest stable source preparation and immutable input verification.",
    match = ["node tools/embctl.ts upstream prepare", "node tools/embctl.ts upstream check"],
    not_match = ["node tools/embctl.ts upstream arbitrary"],
)
prefix_rule(
    pattern = ["node", "tools/embctl.ts", "campaign", ["init", "status", "step", "run", "attach", "retry", "resolve", "reopen", "report"]],
    decision = "allow",
    justification = "Approved checkpoint and bounded recovery entrypoints; no manufactured user answer.",
    match = ["node tools/embctl.ts campaign run --campaign output/campaigns/example --timeout 600"],
    not_match = ["node tools/embctl.ts campaign answer --campaign example --answer answer.json", "node tools/embctl.ts campaign _work --campaign example", "node tools/embctl.ts approve --model example"],
)
prefix_rule(
    pattern = ["node", "tools/campaign_e2e.ts", "--mode", ["freeze", "discovery", "campaign", "continuity"]],
    decision = "allow",
    justification = "Fixed actual Luna/none evaluation, approved receipts and owned caller interruption.",
    match = ["node tools/campaign_e2e.ts --mode discovery --evaluation output/evaluations/example", "node tools/campaign_e2e.ts --mode continuity --evaluation output/evaluations/example --campaign output/campaigns/example"],
    not_match = ["node tools/campaign_e2e.ts --mode arbitrary", "codex exec"],
)
prefix_rule(
    pattern = ["node", "tools/review.ts"],
    decision = "allow",
    justification = "Fixed highest-model local source review; extra CLI arguments are rejected.",
    match = ["node tools/review.ts"],
    not_match = ["codex review --uncommitted", "node tools/other.ts"],
)
prefix_rule(
    pattern = ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
    decision = "allow",
    justification = "Install the committed exact host toolchain lock without lifecycle scripts.",
    match = ["npm ci --ignore-scripts --no-audit --no-fund"],
    not_match = ["npm exec arbitrary", "npm install arbitrary"],
)
prefix_rule(
    pattern = ["docker", ["ps", "images"]],
    decision = "allow",
    justification = "Read-only inventory of the approved workload.",
    match = ["docker ps -a --filter label=easy-emb.attempt", "docker images"],
    not_match = ["docker run example", "docker system prune"],
)
prefix_rule(
    pattern = ["docker", "stats", "--no-stream"],
    decision = "allow",
    justification = "One-shot resource observation.",
    match = ["docker stats --no-stream"],
    not_match = ["docker stats", "docker system prune"],
)
