# Role-owned fixed TypeScript entrypoints. Strategy HITL remains mandatory.
prefix_rule(
    pattern = ["node",".agents/validation/verify.ts"],
    decision = "allow",
    justification = "Fixed typecheck, lint, harness and wiki tests with recorded logs.",
    match = ["node .agents/validation/verify.ts","node .agents/validation/verify.ts --suite harness"],
    not_match = ["node -e process.exit()"],
)
prefix_rule(
    pattern = ["node",".agents/skills/terraforming-node/src/cli.ts","init"],
    decision = "allow",
    justification = "Terraforming-owned bounded host observation.",
    match = ["node .agents/skills/terraforming-node/src/cli.ts init --out manifest.yaml"],
    not_match = ["node .agents/skills/terraforming-node/src/cli.ts serve","node .agents/skills/terraforming-node/src/cli.ts arbitrary"],
)
prefix_rule(
    pattern = ["node",".agents/skills/embedding-upstream/src/cli.ts",["prepare","check","build"]],
    decision = "allow",
    justification = "Upstream-owned source preparation and receipt-checked image builds.",
    match = ["node .agents/skills/embedding-upstream/src/cli.ts prepare","node .agents/skills/embedding-upstream/src/cli.ts build --strategy output/model/strategies/approved.yaml"],
    not_match = ["node .agents/skills/embedding-upstream/src/cli.ts serve","node .agents/skills/embedding-upstream/src/cli.ts arbitrary"],
)
prefix_rule(
    pattern = ["node",".agents/skills/embedding-explorer/src/cli.ts",["inventory","inspect","render","serve","capture","stop"]],
    decision = "allow",
    justification = "Explorer-owned approved lifecycle guarded by receipts and ownership.",
    match = ["node .agents/skills/embedding-explorer/src/cli.ts inspect --model /path/to/model","node .agents/skills/embedding-explorer/src/cli.ts serve --attempt output/model/attempts/example"],
    not_match = ["node .agents/skills/embedding-explorer/src/cli.ts approve --model example","node .agents/skills/embedding-explorer/src/cli.ts build"],
)
prefix_rule(
    pattern = ["node",".agents/skills/embedding-lite-bench/src/cli.ts",["bench","report"]],
    decision = "allow",
    justification = "Lite-bench-owned bounded measurement and current evidence reports.",
    match = ["node .agents/skills/embedding-lite-bench/src/cli.ts bench --attempt output/model/attempts/example","node .agents/skills/embedding-lite-bench/src/cli.ts report"],
    not_match = ["node .agents/skills/embedding-lite-bench/src/cli.ts serve","node .agents/skills/embedding-lite-bench/src/cli.ts arbitrary"],
)
prefix_rule(
    pattern = ["node",".agents/skills/embedding-explorer/src/cli.ts","campaign",["init","status","step","run","attach","retry","resolve","reopen","report"]],
    decision = "allow",
    justification = "Approved checkpoint and bounded recovery entrypoints; no manufactured user answer.",
    match = ["node .agents/skills/embedding-explorer/src/cli.ts campaign run --campaign output/campaigns/example --timeout 600"],
    not_match = ["node .agents/skills/embedding-explorer/src/cli.ts campaign answer --campaign example --answer answer.json","node .agents/skills/embedding-explorer/src/cli.ts campaign _work --campaign example","node .agents/skills/embedding-explorer/src/cli.ts approve --model example"],
)
prefix_rule(
    pattern = ["node",".agents/validation/campaign_e2e.ts","--mode",["freeze","discovery","campaign","continuity"]],
    decision = "allow",
    justification = "Fixed actual Luna/none evaluation with approved receipts and owned caller interruption.",
    match = ["node .agents/validation/campaign_e2e.ts --mode discovery --evaluation output/evaluations/example","node .agents/validation/campaign_e2e.ts --mode continuity --evaluation output/evaluations/example --campaign output/campaigns/example"],
    not_match = ["node .agents/validation/campaign_e2e.ts --mode arbitrary","codex exec"],
)
prefix_rule(
    pattern = ["node",".agents/validation/review.ts"],
    decision = "allow",
    justification = "Fixed highest-model source review; extra CLI arguments are rejected.",
    match = ["node .agents/validation/review.ts"],
    not_match = ["codex review --uncommitted","node .agents/validation/other.ts"],
)
prefix_rule(
    pattern = ["npm", "ci", "--ignore-scripts", "--no-audit", "--no-fund"],
    decision = "allow",
    justification = "Install the committed exact host toolchain lock without lifecycle scripts.",
    match = ["npm ci --ignore-scripts --no-audit --no-fund"],
    not_match = ["npm exec arbitrary", "npm install arbitrary"],
)
prefix_rule(
    pattern = ["docker", ["ps", "images"]],
    decision = "allow",
    justification = "Read-only inventory of the approved workload.",
    match = ["docker ps -a --filter label=easy-emb.attempt", "docker images"],
    not_match = ["docker run example", "docker system prune"],
)
prefix_rule(
    pattern = ["docker", "stats", "--no-stream"],
    decision = "allow",
    justification = "One-shot resource observation.",
    match = ["docker stats --no-stream"],
    not_match = ["docker stats", "docker system prune"],
)
