# Native Codex execution rules. Trusted project layer; load on a new session.
# Serving HITL receipts remain mandatory in AGENTS.md and embctl.

prefix_rule(
    pattern = ["python3", "tools/verify.py"],
    decision = "allow",
    justification = "Project Python/wiki regression tests and fixed log capture.",
    match = ["python3 tools/verify.py --suite python", "python3 tools/verify.py --suite wiki"],
    not_match = ["python3 tools/other.py", "python3 -c \"print(1)\""],
)

prefix_rule(
    pattern = ["python3", "tools/embctl.py", ["init", "inventory", "inspect", "render", "build", "serve", "bench", "capture", "report", "stop"]],
    decision = "allow",
    justification = "Approved embedding lifecycle; the helper validates serving strategy and resource ownership.",
    match = ["python3 tools/embctl.py inspect --model /path/to/model", "python3 tools/embctl.py build --strategy output/model/strategies/approved.yaml"],
    not_match = ["python3 tools/embctl.py approve --model /path/to/model", "python3 -c \"print(1)\""],
)

prefix_rule(
    pattern = ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"],
    decision = "allow",
    justification = "Previously approved project Python regression command.",
    match = ["python3 -m unittest discover -s tests -v"],
    not_match = ["python3 -m unittest discover -s other-tests -v"],
)

prefix_rule(
    pattern = ["python3", "tools/embctl.py", "campaign", ["init", "status", "step", "run", "attach", "retry", "resolve", "reopen", "report"]],
    decision = "allow",
    justification = "Approved campaign checkpoints and recovery; existing strategy receipts and worker leases remain required.",
    match = ["python3 tools/embctl.py campaign run --campaign output/campaigns/example --timeout 600", "python3 tools/embctl.py campaign retry --campaign output/campaigns/example --cell a --reason failure --hypothesis fix --change patch"],
    not_match = ["python3 tools/embctl.py approve --model /path/to/model", "python3 tools/embctl.py campaign answer --campaign output/campaigns/example --answer answer.json", "python3 tools/embctl.py campaign _work --campaign output/campaigns/example", "python3 -c \"print(1)\""],
)

prefix_rule(
    pattern = ["python3", "tools/campaign_e2e.py", "--mode", ["discovery", "continuity"]],
    decision = "allow",
    justification = "Project continuity driver: real Codex calls and bounded caller termination for a campaign with approved receipts.",
    match = ["python3 tools/campaign_e2e.py --mode discovery", "python3 tools/campaign_e2e.py --mode continuity --campaign output/campaigns/example --timeout 1800"],
    not_match = ["python3 tools/campaign_e2e.py --mode arbitrary", "python3 tools/other.py"],
)

prefix_rule(
    pattern = ["docker", ["ps", "images"]],
    decision = "allow",
    justification = "Read-only container and image inventory used before and after the approved campaign.",
    match = ["docker ps -a --filter label=easy-emb.attempt", "docker images"],
    not_match = ["docker run example", "docker system prune", "docker rm example"],
)

prefix_rule(
    pattern = ["docker", "stats", "--no-stream"],
    decision = "allow",
    justification = "One-shot resource observation during the approved embedding workload.",
    match = ["docker stats --no-stream"],
    not_match = ["docker stats", "docker system prune"],
)



prefix_rule(
    pattern = ["python3", "tools/review.py"],
    decision = "allow",
    justification = "Fixed local Codex review entrypoint rejects all extra arguments before launching the reviewer.",
    match = ["python3 tools/review.py"],
    not_match = ["codex review --uncommitted", "python3 tools/other.py"],
)
